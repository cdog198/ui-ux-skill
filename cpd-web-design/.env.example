# Copy to .env.local for local dev; set the same variables in Vercel → Project → Settings → Environment Variables.

# Your live domain (used for SEO, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.cpdwebdesign.com

# Contact form endpoint, e.g. a Formspree form: https://formspree.io/f/abcdwxyz
# Leave unset to use the value in src/config/site.ts (demo mode until you change it).
NEXT_PUBLIC_FORM_ENDPOINT=
