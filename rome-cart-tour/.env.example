# Copy to .env and fill in. Everything prefixed VITE_ ends up in the browser bundle – never put secrets
# there that would let someone write data (Supabase anon keys are designed to be public).

# Optional. Without it the map uses OpenFreeMap (free, no key). With it, MapTiler serves the same tiles.
VITE_MAPTILER_KEY=

# "Leave us a review" button.
VITE_GYG_REVIEW_URL=https://www.getyourguide.com/

# Draw the street-routed loop from `npm run route` (true/false). Off: all stops, no fixed line.
VITE_SHOW_LOOP_ROUTE=false
